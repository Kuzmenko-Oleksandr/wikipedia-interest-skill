#!/bin/sh
# Runs the wikitrends CLI from the skill directory, whatever the caller's working directory.
# Prefers the skill's own .venv when it exists.
skill_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
python=python3
if [ -x "$skill_dir/.venv/bin/python" ]; then
    python="$skill_dir/.venv/bin/python"
fi
# Some sandboxes hand over a directory as stdin and Python refuses to start; the CLI never reads it.
if [ -d /dev/stdin ]; then
    exec 0<&-
fi
# Apple Silicon: a shell under Rosetta (Intel Homebrew's /usr/local/bin/bash, a Rosetta
# terminal) starts a universal2 Python (python.org, Xcode) as x86_64, and the arm64 wheels in
# .venv fail to load; the reverse happens to a .venv built under Rosetta. Run Python in the
# architecture its numpy wheel was built for whenever that differs from the current one.
arch=
if [ "$(uname -s)" = Darwin ]; then
    for wheel in "$skill_dir"/.venv/lib/python3.*/site-packages/numpy-*.dist-info/WHEEL; do
        [ -f "$wheel" ] || continue
        case $(cat -- "$wheel") in
            *_arm64*) arch=arm64 ;;
            *_x86_64*) arch=x86_64 ;;
        esac
    done
    if [ "$arch" = "$(uname -m)" ]; then
        arch=
    fi
fi
export PYTHONPATH="$skill_dir${PYTHONPATH:+:$PYTHONPATH}"
if [ -n "$arch" ]; then
    exec arch "-$arch" "$python" -m wikitrends "$@"
fi
exec "$python" -m wikitrends "$@"
